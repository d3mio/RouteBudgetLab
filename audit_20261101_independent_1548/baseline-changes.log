+        current_flow_steps++;
+        if (max_flow_steps >= 0 && current_flow_steps > max_flow_steps) {
+            interrupted = true;
+            deadline_exceeded = true;
+            return false;
+        }
+        if (isGlobalBudgetExhausted(0.0)) {
+            interrupted = true;
+            deadline_exceeded = true;
+            return false;
+        }
+        return true;
+    }
