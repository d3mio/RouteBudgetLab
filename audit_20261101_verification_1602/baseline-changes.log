     }
 
+    inline double getRemainingGlobalSeconds() const {
+        if (deadline_exceeded) return 0.0;
+        if (has_global_deadline) {
+            auto now = std::chrono::steady_clock::now();
+            return std::chrono::duration<double>(global_deadline_time - now).count();
